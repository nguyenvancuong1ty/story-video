{
  "name": "knowledge-story-video-factory",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "9.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "22.x",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "second-act:footage": "python scripts/openmontage-retrieve.py --spec examples/second-act-gray-divorce.visual-spec.json --output out/second-act/footage",
    "second-act:pilot": "tsx scripts/run-second-act.ts"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
