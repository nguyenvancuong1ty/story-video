OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=
OPENAI_EDITORIAL_MODEL=
OPENAI_IMAGE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
LOCAL_LLM_BASE_URL=http://localhost:20128/v1
LOCAL_LLM_MODEL=cx/gpt-5.6-terra
LLM_PROVIDER=local
IMAGE_PROVIDER=local
LOCAL_IMAGE_BASE_URL=http://localhost:20128/v1
LOCAL_IMAGE_MODEL=ag/gemini-3.1-flash-image
# Set LLM_PROVIDER=openrouter and/or IMAGE_PROVIDER=openrouter to use OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=
OPENROUTER_LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=
OPENROUTER_IMAGE_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_TRANSPORT=curl
CAPCUT_TTS_BASE_URL=http://127.0.0.1:8765
CAPCUT_TTS_VOICE_INDEX=0
CAPCUT_TTS_RATE=1.0

# Second Act Stories / OpenMontage integration.
# Point OPENMONTAGE_PATH at a local checkout of https://github.com/calesthio/OpenMontage.
OPENMONTAGE_PATH=
# Optional Python executable from the environment where OpenMontage was installed.
# Windows example: C:\\AI\\OpenMontage\\.venv\\Scripts\\python.exe
# Linux/macOS example: /opt/OpenMontage/.venv/bin/python
OPENMONTAGE_PYTHON=

# Lowest-risk production default: retrieve video only from Pexels and reject unknown/restrictive licenses.
# Create a free Pexels API key and paste it here. Leave SECOND_ACT_STOCK_SOURCES blank to let
# OpenMontage search every configured source; safe mode will still filter the returned clips.
PEXELS_API_KEY=
SECOND_ACT_STOCK_SOURCES=pexels
SECOND_ACT_LICENSE_MODE=safe
SECOND_ACT_CLIPS_PER_QUERY=2

# Optional licensed audio owned by you. Source stock-video audio is always muted.
# SECOND_ACT_MUSIC_PATH points to one background music file.
# SECOND_ACT_AMBIENCE_DIR may contain files named room-tone, rain, suburban-traffic,
# office, car-interior and paper, using mp3/wav/m4a/aac extensions.
SECOND_ACT_MUSIC_PATH=
SECOND_ACT_AMBIENCE_DIR=

DATABASE_URL=postgres://story_video:story_video@localhost:15432/story_video
REDIS_URL=redis://localhost:16379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=story_video
S3_SECRET_KEY=story_video_secret

# Second Act local worker: Google Sheets -> local render -> Google Drive.
SECOND_ACT_SHEET_ID=1WN099M7PEnJlS5D_mOfLJ27NnaG93pgNhrqOXjRKFZw
SECOND_ACT_SHEET_TAB=CONTENT_QUEUE
SECOND_ACT_GOOGLE_CLIENT_ID=
SECOND_ACT_GOOGLE_CLIENT_SECRET=
SECOND_ACT_GOOGLE_TOKEN_PATH=.second-act/google-token.json
SECOND_ACT_DRIVE_FOLDER_ID=
SECOND_ACT_DRIVE_FOLDER_NAME=Second Act Stories Renders
SECOND_ACT_WORKER_POLL_MS=60000
SECOND_ACT_WORKER_MINUTES=4
